# --- Database -------------------------------------------------
DATABASE_URL="postgresql://aiassets:CHANGE_ME@localhost:5432/aiassets?schema=public"

# --- Site -------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# --- NextAuth -----------------------------------------------------
AUTH_SECRET="generate-with: openssl rand -base64 32"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@yourdomain.com"

# --- Crawlers (optional but recommended) --------------------------
GITHUB_TOKEN=""        # raises GitHub API rate limit from 60/hr to 5000/hr
HF_TOKEN=""             # optional, raises Hugging Face API rate limit
PRODUCTHUNT_TOKEN=""    # required for the Product Hunt crawler (free dev token)

# --- Premium system — leave all false for MVP ----------------------
VIP_ENABLED=false
CRYPTO_ENABLED=false
PAYPAL_ENABLED=false
SPONSORED_ENABLED=false
