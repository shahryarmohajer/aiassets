// ==========================================================
// AI Assets Search Engine — Prisma schema
// PostgreSQL + built-in Full Text Search (no external search engine)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------
// Enums
// ---------------------------

enum ContentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkflowPlatform {
  N8N
  MAKE
  ZAPIER
}

enum CreditStatus {
  ACTIVE
  EXPIRED
  UNKNOWN
}

enum CrawlerStatus {
  SUCCESS
  FAILED
  PARTIAL
}

// ---------------------------
// Shared taxonomy
// ---------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  prompts   Prompt[]
  workflows Workflow[]
  templates Template[]

  @@index([slug])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  prompts   PromptTag[]
  workflows WorkflowTag[]
  templates TemplateTag[]

  @@index([slug])
}

// ---------------------------
// Prompts
// ---------------------------

model Prompt {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  description    String
  promptContent  String        @map("prompt_content")
  categoryId     String?       @map("category_id")
  category       Category?     @relation(fields: [categoryId], references: [id])
  sourceUrl      String?       @map("source_url")
  views          Int           @default(0)
  votes          Int           @default(0)
  status         ContentStatus @default(PENDING)
  featured       Boolean       @default(false)

  // premium placeholder — inert while VIP_ENABLED=false
  isPremium      Boolean       @default(false) @map("is_premium")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tags           PromptTag[]
  favorites      Favorite[]
  voteRecords    Vote[]

  /// tsvector generated column, maintained by trigger (see migration.sql)
  searchVector   Unsupported("tsvector")? @map("search_vector")

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([votes])
  @@map("prompts")
}

model PromptTag {
  promptId String @map("prompt_id")
  tagId    String @map("tag_id")
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([promptId, tagId])
  @@map("prompt_tags")
}

// ---------------------------
// Workflows (n8n / Make / Zapier)
// ---------------------------

model Workflow {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  description  String
  platform     WorkflowPlatform
  workflowJson Json              @map("workflow_json")
  categoryId   String?           @map("category_id")
  category     Category?         @relation(fields: [categoryId], references: [id])
  sourceUrl    String?           @map("source_url")
  views        Int               @default(0)
  votes        Int               @default(0)
  status       ContentStatus     @default(PENDING)
  featured     Boolean           @default(false)

  isPremium    Boolean           @default(false) @map("is_premium")

  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  tags         WorkflowTag[]
  favorites    Favorite[]
  voteRecords  Vote[]

  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([categoryId])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
  @@map("workflows")
}

model WorkflowTag {
  workflowId String   @map("workflow_id")
  tagId      String   @map("tag_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workflowId, tagId])
  @@map("workflow_tags")
}

// ---------------------------
// Free Credits / Promotions / Coupons
// ---------------------------

model FreeCredit {
  id               String       @id @default(cuid())
  provider         String
  slug             String       @unique
  offerTitle       String       @map("offer_title")
  offerDescription String       @map("offer_description")
  couponCode       String?      @map("coupon_code")
  expirationDate   DateTime?    @map("expiration_date")
  sourceUrl        String       @map("source_url")
  status           CreditStatus @default(ACTIVE)
  views            Int          @default(0)

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  favorites        Favorite[]

  searchVector     Unsupported("tsvector")? @map("search_vector")

  @@index([status])
  @@index([createdAt])
  @@map("free_credits")
}

// ---------------------------
// Templates (Cursor Rules, MCP servers, generic downloadable templates)
// ---------------------------

model Template {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  categoryId  String?       @map("category_id")
  category    Category?     @relation(fields: [categoryId], references: [id])
  downloadUrl String        @map("download_url")
  sourceUrl   String?       @map("source_url")
  views       Int           @default(0)
  status      ContentStatus @default(PENDING)

  isPremium   Boolean       @default(false) @map("is_premium")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tags        TemplateTag[]
  favorites   Favorite[]

  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("templates")
}

model TemplateTag {
  templateId String   @map("template_id")
  tagId      String   @map("tag_id")
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
  @@map("template_tags")
}

// ---------------------------
// Users / Auth (NextAuth)
// ---------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash") // set only for email/password accounts; null for OAuth-only users
  role          String    @default("user") // "user" | "admin"
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  votes         Vote[]
  followedCategories UserCategoryFollow[]

  // premium placeholder — inert while VIP_ENABLED=false
  vipStatus     Boolean   @default(false) @map("vip_status")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Vote {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  promptId   String?   @map("prompt_id")
  prompt     Prompt?   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  workflowId String?   @map("workflow_id")
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  // one vote per user per asset
  @@unique([userId, promptId])
  @@unique([userId, workflowId])
  @@map("votes")
}

model Favorite {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  promptId     String?     @map("prompt_id")
  prompt       Prompt?     @relation(fields: [promptId], references: [id], onDelete: Cascade)
  workflowId   String?     @map("workflow_id")
  workflow     Workflow?   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  templateId   String?     @map("template_id")
  template     Template?   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  freeCreditId String?     @map("free_credit_id")
  freeCredit   FreeCredit? @relation(fields: [freeCreditId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("favorites")
}

model UserCategoryFollow {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryName String @map("category_name")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, categoryName])
  @@map("user_category_follows")
}

// ---------------------------
// Crawlers
// ---------------------------

model CrawlerLog {
  id           String        @id @default(cuid())
  source       String // "reddit" | "github" | "flowgpt" | "huggingface" | "producthunt" | ...
  status       CrawlerStatus
  itemsFound   Int           @default(0) @map("items_found")
  itemsSaved   Int           @default(0) @map("items_saved")
  itemsSkipped Int           @default(0) @map("items_skipped")
  errorMessage String?       @map("error_message") @db.Text
  startedAt    DateTime      @map("started_at")
  finishedAt   DateTime?     @map("finished_at")

  @@index([source])
  @@index([startedAt])
  @@map("crawler_logs")
}

// dedupe fingerprint so crawlers don't re-insert the same source URL twice
model SeenSource {
  id        String   @id @default(cuid())
  urlHash   String   @unique @map("url_hash")
  sourceUrl String   @map("source_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("seen_sources")
}

// ---------------------------
// Search analytics (for admin dashboard)
// ---------------------------

model SearchQuery {
  id        String   @id @default(cuid())
  query     String
  resultsCount Int   @default(0) @map("results_count")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([query])
  @@index([createdAt])
  @@map("search_queries")
}

// ---------------------------
// Premium system — tables exist, all functionality inert
// (gated at the application layer by VIP_ENABLED / *_ENABLED env vars)
// ---------------------------

model SponsoredListing {
  id         String   @id @default(cuid())
  title      String
  targetUrl  String   @map("target_url")
  imageUrl   String?  @map("image_url")
  active     Boolean  @default(false) // always false while SPONSORED_ENABLED=false
  startsAt   DateTime? @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("sponsored_listings")
}

model PaymentRecord {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  method       String   // "usdt_trc20" | "usdt_bep20" | "bitcoin" | "ethereum" | "paypal"
  amount       Decimal  @db.Decimal(10, 2)
  currency     String
  status       String   @default("disabled") // always "disabled" while payments are off
  externalRef  String?  @map("external_ref")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("payment_records")
}
